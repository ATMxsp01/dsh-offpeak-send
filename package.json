{
  "name": "@carbonzhao/dsh-offpeak-send",
  "version": "0.2.0",
  "description": "Queue messages to DeepSeek off-peak (half-price) hours — 谷时发送：per-session toggle, host-persisted session prefs, 2027 holidays; maintained fork",
  "type": "module",
  "main": "./lib/index.js",
  "author": "CarbonZhao",
  "contributors": [
    "ATMxsp01"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATMxsp01/dsh-offpeak-send.git"
  },
  "homepage": "https://github.com/ATMxsp01/dsh-offpeak-send#readme",
  "bugs": {
    "url": "https://github.com/ATMxsp01/dsh-offpeak-send/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "off-peak",
    "cost-saving",
    "queue",
    "scheduler",
    "composer",
    "per-session"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/link-deps.mjs && node scripts/inline-clock.mjs",
    "inline": "node scripts/inline-clock.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/outbox.js && node --check lib/deliver.js && node --check lib/gc.js",
    "test": "node --test test/clock.test.mjs test/outbox.test.mjs test/gc-refs.test.mjs test/client-inline.test.mjs test/prefs.test.mjs"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-0 <2",
    "@deepseek-ai/dsh-llm": ">=0.1.0-0 <2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-0 <2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
